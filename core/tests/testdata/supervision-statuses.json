        { "seq": 2, "type": "acknowledged", "class": "control", "payload": { "ack_of": 1, "disposition": "accepted", "note": "Reverting." }, "producer": { "principal": { "kind": "user", "id": "owner" }, "session_id": "sess-a", "is_investigation_author": true } },
        { "seq": 3, "type": "decision.proposed", "class": "semantic", "payload": { "semantic_id": "decision_revert", "statement": "Reverted the restore change.", "refs": ["#1"] }, "producer": { "principal": { "kind": "user", "id": "owner" }, "session_id": "sess-a", "is_investigation_author": true } }
