{
  "description": "Delegated supervision: event streams -> challengeStatuses (packages/shared/src/investigation/supervision.ts). The Cardinal plugin's Python mirror runs the same cases. expected: every challenge.added of the stream, by seq, -> {status, ruling_seq, owner_seq}. Events carry the wire fields the derivation reads (seq, type, class, payload, producer.is_investigation_author).",
  "version": 1,
  "cases": [
    {
      "name": "no challenges: nothing to report",
      "events": [
        { "seq": 1, "type": "cue.added", "class": "control", "payload": { "text": "Look at the restore path." }, "producer": { "principal": { "kind": "grantee", "id": "grt_000000000000000000000001" }, "session_id": null, "is_investigation_author": false } },
        { "seq": 2, "type": "finding.proposed", "class": "semantic", "payload": { "semantic_id": "finding_a", "statement": "Restore is slow." }, "producer": { "principal": { "kind": "user", "id": "owner" }, "session_id": "sess-a", "is_investigation_author": true } }
      ],
      "expected": {}
    },
    {
      "name": "open: a challenge with no acknowledgment",
      "events": [
        { "seq": 1, "type": "challenge.added", "class": "control", "payload": { "text": "This commit changes shared restore code beyond what was approved." }, "producer": { "principal": { "kind": "grantee", "id": "grt_000000000000000000000001" }, "session_id": null, "is_investigation_author": false } }
      ],
      "expected": { "1": { "status": "open", "ruling_seq": null, "owner_seq": null } }
    },
    {
      "name": "open: a legacy noted ack is not a position",
      "events": [
        { "seq": 1, "type": "challenge.added", "class": "control", "payload": { "text": "Out of scope change." }, "producer": { "principal": { "kind": "grantee", "id": "grt_000000000000000000000001" }, "session_id": null, "is_investigation_author": false } },
        { "seq": 2, "type": "acknowledged", "class": "control", "payload": { "ack_of": 1, "disposition": "noted" }, "producer": { "principal": { "kind": "user", "id": "owner" }, "session_id": "sess-a", "is_investigation_author": true } }
      ],
      "expected": { "1": { "status": "open", "ruling_seq": null, "owner_seq": null } }
    },
    {
      "name": "open: a non-author ack is not a position",
      "events": [
        { "seq": 1, "type": "challenge.added", "class": "control", "payload": { "text": "Out of scope change." }, "producer": { "principal": { "kind": "grantee", "id": "grt_000000000000000000000001" }, "session_id": null, "is_investigation_author": false } },
        { "seq": 2, "type": "acknowledged", "class": "control", "payload": { "ack_of": 1, "disposition": "accepted", "note": "Will revert." }, "producer": { "principal": { "kind": "user", "id": "someone-else" }, "session_id": "sess-x", "is_investigation_author": false } }
      ],
      "expected": { "1": { "status": "open", "ruling_seq": null, "owner_seq": null } }
    },
    {
      "name": "accepted: the worker accepted with a plan",
      "events": [
        { "seq": 1, "type": "challenge.added", "class": "control", "payload": { "text": "Out of scope change." }, "producer": { "principal": { "kind": "grantee", "id": "grt_000000000000000000000001" }, "session_id": null, "is_investigation_author": false } },
        { "seq": 2, "type": "acknowledged", "class": "control", "payload": { "ack_of": 1, "disposition": "accepted", "note": "Reverting the restore change; keeping only the approved fix." }, "producer": { "principal": { "kind": "user", "id": "owner" }, "session_id": "sess-a", "is_investigation_author": true } }
      ],
      "expected": { "1": { "status": "accepted", "ruling_seq": null, "owner_seq": null } }
    },
    {
