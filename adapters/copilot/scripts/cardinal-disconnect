#!/usr/bin/env python3
"""Disconnect GitHub Copilot CLI from Cardinal.

Removes the managed `cardinal` and `cardinal-behavior` entries from Copilot
CLI's user MCP config (only while they are still the entries cardinal-connect
recorded writing), best-effort revokes the ingest, MCP and control-plane keys
server-side, then removes local state. The plugin's hooks stay installed with
the plugin and go silent again (`copilot plugin uninstall cardinal` removes
them).
"""

from __future__ import annotations

import argparse
import json
import shutil
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

PLUGIN_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(PLUGIN_ROOT / "hooks"))
import _copilot_config as config  # noqa: E402
from cardinal_core import tls as _tls  # noqa: E402,F401  (a pinned self-signed host)

COPILOT_DIR = Path.home() / ".copilot"
STATE_PATH = COPILOT_DIR / "cardinal.json"
SECRETS_PATH = COPILOT_DIR / "cardinal-secrets.json"
RUNTIME_DIR = COPILOT_DIR / "cardinal"


def atomic_write(path: Path, content: str) -> None:
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(content)
    tmp.chmod(0o600)
    tmp.replace(path)


def backup(path: Path) -> Path | None:
    if not path.exists():
        return None
    ts = time.strftime("%Y%m%d-%H%M%S")
    target = path.with_suffix(f"{path.suffix}.bak.{ts}")
    target.write_text(path.read_text())
    target.chmod(0o600)
    return target


def load_json(path: Path) -> dict:
    if not path.exists():
        return {}
    try:
        data = json.loads(path.read_text())
    except Exception as exc:
        sys.exit(f"Refusing to proceed: {path} is unreadable ({exc})")
    if not isinstance(data, dict):
        sys.exit(f"Refusing to proceed: {path} is not a JSON object.")
    return data


def remove_mcp_entries(path: Path, managed: dict) -> bool:
    """Remove Cardinal's entries from mcp-config.json. True when anything was
    removed."""
    try:
        data, removed, kept = config.remove_entries(path, managed)
    except config.ConfigError as exc:
        print(f"Could not update {path}: {exc}")
        return False
    for name in kept:
        print(f"Skipping mcpServers.{name} in {path}: cardinal-connect did not write it (or it was changed).")
    if data is None:
        return False
    b = backup(path)
    atomic_write(path, json.dumps(data, indent=2) + "\n")
    print(f"Removed managed Cardinal MCP entries ({', '.join(removed)}) from {path}")
    if b:
        print(f"Backup: {b}")
    return True


def revoke_key(host: str, key_id: str, plaintext: str | None) -> tuple[bool, str]:
    url = host.rstrip("/") + f"/api/maestro-keys/{key_id}/revoke"
    headers = {"content-type": "application/json"}
    if plaintext:
        headers["X-CardinalHQ-API-Key"] = plaintext
    req = urllib.request.Request(url, data=b"", method="POST", headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            return resp.status in (200, 204), f"HTTP {resp.status}"
    except urllib.error.HTTPError as exc:
        return False, f"HTTP {exc.code}"
    except (urllib.error.URLError, TimeoutError) as exc:
        return False, f"network error: {exc}"


def remove_checks_skill(runtime: str) -> None:
    """The Checks preview's skill copy in this plugin's skills/checks/
    (cardinal-checks on): removed with the connection, before the runtime
    dir (and its enabled.json) goes. Best-effort."""
    try:
        from cardinal_core import checks_install

        dest = checks_install.install_dir(runtime, PLUGIN_ROOT)
        if checks_install.uninstall(dest):
            print(f"Removed the Checks preview skill {dest}")
    except Exception as exc:  # noqa: BLE001
        print(f"Could not remove the Checks preview skill: {exc}")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="cardinal-disconnect",
        description="Disconnect GitHub Copilot CLI from Cardinal.",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="Do not fail if ~/.copilot/cardinal.json is missing.",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()

    if not STATE_PATH.exists() and not args.force:
        print("Cardinal is not connected. Nothing to do.")
        return 0

    state = load_json(STATE_PATH)
    host = state.get("host") or "https://app.cardinalhq.io"
    secrets = load_json(SECRETS_PATH)
    mcp_config = Path(state.get("mcp_config_path") or config.mcp_config_path())

    def revoke(label: str, key_id: str | None, plaintext, prefix) -> None:
        if not key_id:
            return
        ok, msg = revoke_key(host, key_id, plaintext if isinstance(plaintext, str) else None)
        if ok:
            print(f"Revoked {label} {prefix or key_id} server-side ({msg})")
        else:
            print(f"Could not revoke {label} server-side ({msg}).")
            print(f"Visit {host}/settings/api-keys to revoke it manually.")

    revoke("ingest key", state.get("ingest_key_id"), secrets.get("ingest_api_key"), state.get("ingest_key_prefix"))
    revoke("MCP key", state.get("mcp_key_id"), config.gateway_key(mcp_config) or secrets.get("mcp_api_key"),
           state.get("mcp_key_prefix"))
    # The control-plane token acts as the user across their orgs: revoke it
    # before its key_id and plaintext leave the state and secrets files.
    revoke("control-plane token", state.get("act_key_id"), secrets.get("act_api_key"), state.get("act_key_prefix"))

    managed = state.get("managed_mcp") if isinstance(state.get("managed_mcp"), dict) else {}
    if not remove_mcp_entries(mcp_config, managed):
        print(f"No managed Cardinal MCP entry found in {mcp_config}")

    if SECRETS_PATH.exists():
        SECRETS_PATH.unlink()
        print(f"Removed {SECRETS_PATH}")

    if STATE_PATH.exists():
        STATE_PATH.unlink()
        print(f"Removed {STATE_PATH}")

    remove_checks_skill("copilot")

    if RUNTIME_DIR.exists():
        # Includes the owner-input consent (cardinal-connect --owner-input):
        # a later connect starts with owner input off again.
        consented = (RUNTIME_DIR / "owner-input-consent.json").exists()
        shutil.rmtree(RUNTIME_DIR, ignore_errors=True)
        print(f"Removed {RUNTIME_DIR}")
        if consented:
            print("Cleared the owner-input consent (cardinal-connect --owner-input on asks again).")

    print()
    print("Start a new Copilot CLI session (or /restart) so it drops the Cardinal MCP servers.")
    print("The plugin's hooks stay installed but do nothing until you connect again;")
    print("`copilot plugin uninstall cardinal` removes the plugin.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
