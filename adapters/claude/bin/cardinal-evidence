#!/usr/bin/env python3
"""cardinal-evidence — cite results from other MCP servers in a storyboard.

The evidence-capture hook keeps the result of every call to a non-Cardinal
MCP server on this machine (~/.cardinal/evidence/<session>/ev_<id>.json,
scrubbed, capped at 256 KiB, removed after 14 days). Nothing is uploaded
until you promote it: `promote` sends the entries you name to a draft
storyboard, and Cardinal stores each as a *captured* receipt (rcpt_…) that
scenes bind like any other receipt.

Commands:
  promote [--storyboard sb_…] ev_… [ev_…]
      Upload spool entries to the storyboard's evidence route,
      POST <maestro>/api/orgs/<org>/storyboards/<id>/evidence
      (conductor routes/storyboards-evidence.ts), as {items: [{provenance:
      "captured", source_server, client: "claude-code/<plugin version>",
      client_called_at, tool, args, result}]}. Prints one line per entry:
      "ev_… -> rcpt_…" or "ev_…: error <code>: <message>". Without
      --storyboard, the one storyboard whose evidence token was stored in
      the entries' session is used.
  list [--session ID | --all] [--limit N]
      This session's captured entries (the newest session when Claude Code
      does not say which), plus the storyboards that have a stored token.
  off | on
      Stop / resume capturing (the flag file ~/.cardinal/evidence/disabled
      the capture hook reads). Existing entries stay until they age out.
  status
      Whether capture is on, what the spool holds and where promote uploads.

Credentials, in order: the storyboard's evidence token (storyboard__create
returns it; hooks/storyboard-token.py stores it, 24 h, this storyboard's
evidence upload only) as `Authorization: CardinalEvidence <token>`, then the
Cardinal MCP key from ~/.claude/settings.json (or the environment) as
X-CardinalHQ-API-Key. Either goes only to the origin of CARDINAL_MCP_URL,
never across a redirect. The upload's org is the storyboard's; it must be
the org CARDINAL_MCP_URL names.

Exit codes: 0 every entry promoted (or the command succeeded); 1 some entries
failed (each is listed); 2 nothing was uploaded (usage, connection, auth, or
the storyboard refused the upload).
"""

from __future__ import annotations

import argparse
import http.client
import importlib.util
import json
import os
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

PLUGIN_ROOT = Path(__file__).resolve().parent.parent
HOOKS_DIR = PLUGIN_ROOT / "hooks"
RENDER_PREVIEW = PLUGIN_ROOT / "skills" / "canvas" / "scripts" / "render_preview.py"
sys.path.insert(0, str(HOOKS_DIR))

EXIT_OK = 0
EXIT_ITEM_ERRORS = 1
EXIT_FAILED = 2

# conductor storyboard/evidence-ingest.ts MAX_EVIDENCE_ITEMS.
MAX_ITEMS_PER_REQUEST = 50
# maestro parses an upload up to STORYBOARD_EVIDENCE_BODY_LIMIT ("8mb");
# larger batches are split.
MAX_REQUEST_BYTES = 7 << 20
MAX_429_RETRIES = 3
REQUEST_TIMEOUT_S = 60
MAX_MESSAGE_CHARS = 300
MAX_OTHER_BLOCKS = 1000

RECEIPT_ID_RE = re.compile(r"^rcpt_[0-9a-f]{24}$")
_CONTROL_RE = re.compile(r"[\x00-\x1f\x7f]+")


class PromoteError(Exception):
    def __init__(self, message: str, status: int | None = None, code: str | None = None):
        super().__init__(message)
        self.status = status
        self.code = code


# ---------------------------------------------------------------------------
# Shared pieces
# ---------------------------------------------------------------------------

_RP = None


def render_preview():
    """skills/canvas/scripts/render_preview.py: the connection parsing
    (_origin, MCP_URL_PATH_RE) and the no-redirect opener, reused as is."""
    global _RP
    if _RP is None:
        spec = importlib.util.spec_from_file_location("cardinal_render_preview", RENDER_PREVIEW)
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        _RP = mod
    return _RP


def evidence_mod():
    from cardinal_core import evidence
    return evidence


def home_dir() -> Path:
    return Path(os.environ.get("HOME") or str(Path.home()))


def settings_env(home: Path) -> dict:
    try:
        env = json.loads((home / ".claude" / "settings.json").read_text()).get("env", {})
    except (OSError, ValueError, AttributeError):
        return {}
    return env if isinstance(env, dict) else {}


def connection(home: Path, environ: dict) -> dict:
    """{origin, org, key}: the maestro origin and org of CARDINAL_MCP_URL and
    the Cardinal MCP key (None when absent), from ~/.claude/settings.json's
    env block first (Claude Code does not reliably export it to Bash), then
    the environment. {} when there is no usable URL."""
    rp = render_preview()
    env = settings_env(home)
    url, key = env.get("CARDINAL_MCP_URL"), env.get("CARDINAL_MCP_API_KEY")
    if not (isinstance(url, str) and url):
        url, key = environ.get("CARDINAL_MCP_URL"), environ.get("CARDINAL_MCP_API_KEY")
    if not (isinstance(url, str) and url):
        return {}
    origin = rp._origin(url)
    if origin is None:
        return {}
    m = rp.MCP_URL_PATH_RE.match(urllib.parse.urlsplit(url).path)
    return {
        "origin": origin,
        "org": urllib.parse.unquote(m.group(1)) if m else None,
        "key": key if isinstance(key, str) and key else None,
    }


def plugin_client() -> str:
    """claude-code/<plugin version>, the receipt's `client`."""
    ev = evidence_mod()
    try:
        from _plugin_version import plugin_version
        version = plugin_version()
    except Exception:
        version = None
    return ev.client_string("claude-code", version)


def clip(text, n: int = MAX_MESSAGE_CHARS) -> str:
    """Server- or entry-supplied text, one line, bounded."""
    s = _CONTROL_RE.sub(" ", str(text or "")).strip()
    return s if len(s) <= n else s[: n - 1] + "…"


# ---------------------------------------------------------------------------
# promote
# ---------------------------------------------------------------------------

def wire_result(result) -> dict:
    """A spool entry's result ({structured?, text?, other_blocks?}, or the
    256 KiB truncation envelope) -> the upload's result ({content?,
    structured_content?}). A truncated result is uploaded as its envelope
    ({truncated, original_bytes, prefix}) so the receipt says it was cut."""
    if not isinstance(result, dict):
        raise ValueError("the entry has no result")
    if result.get("truncated") is True and "prefix" in result:
        return {"structured_content": result}
    out: dict = {}
    content = []
    texts = result.get("text")
    if isinstance(texts, list):
        content.extend({"type": "text", "text": t} for t in texts if isinstance(t, str))
    other = result.get("other_blocks")
    if isinstance(other, int) and not isinstance(other, bool) and other > 0:
        # Non-text blocks are counted, never stored (gateway external.go):
        # one untyped placeholder per block the client saw keeps the count.
        content.extend({"type": "other"} for _ in range(min(other, MAX_OTHER_BLOCKS)))
    if content:
        out["content"] = content
    if result.get("structured") is not None:
        out["structured_content"] = result["structured"]
    if not out:
        # An empty result is still what the tool returned.
        out["text"] = ""
    return out


def wire_item(entry: dict, client: str) -> dict:
    """One spool entry -> one upload item (conductor EvidenceItemSchema)."""
    server, tool = entry.get("server"), entry.get("tool")
    if not isinstance(server, str) or not server or not isinstance(tool, str) or not tool:
        raise ValueError("the entry names no server or tool")
    item = {
        "provenance": "captured",
        "source_server": server,
        "client": client,
        "tool": tool,
        "result": wire_result(entry.get("result")),
    }
    if evidence_mod().parse_time(entry.get("called_at")) is not None:
        item["client_called_at"] = entry["called_at"]
    args = entry.get("args")
    if isinstance(args, dict):
        item["args"] = args
    return item


def batches(items: list) -> list:
    """[(ev_id, item, encoded)] -> lists of at most MAX_ITEMS_PER_REQUEST
    items whose request body stays under MAX_REQUEST_BYTES."""
    out, cur, size = [], [], 16
    for row in items:
        n = len(row[2]) + 1
        if cur and (len(cur) >= MAX_ITEMS_PER_REQUEST or size + n > MAX_REQUEST_BYTES):
            out.append(cur)
            cur, size = [], 16
        cur.append(row)
        size += n
    if cur:
        out.append(cur)
    return out


def explain_status(status: int, body: dict, org: str, storyboard_id: str, auth: str) -> str:
    code = str(body.get("error") or "")
    msg = clip(body.get("message"))
    if status == 400:
        return f"maestro rejected the upload ({code or 'bad request'}): {msg or 'upgrade the plugin'}"
    if status == 401:
        if auth == "token":
            return ("the storyboard's evidence token was rejected (expired or revoked): call storyboard__preview "
                    "for a fresh one, or connect with /cardinal:connect")
        return "the Cardinal MCP key was rejected: reconnect with /cardinal:connect --rotate"
    if status == 403:
        if code == "token_scope_mismatch":
            return "the evidence token is for a different storyboard or org"
        if code == "org_scope_mismatch":
            return (f"storyboard {storyboard_id} is in org {org}, which this key cannot reach: "
                    "reconnect to that org (/cardinal:connect --rotate)")
        if code == "insufficient_scope":
            return ("this Cardinal does not let the plugin key upload evidence: upgrade Cardinal, or promote "
                    "right after storyboard__create so its evidence token is used")
        return "forbidden: adding evidence needs the Member role in this org"
    if status == 404:
        if code == "storyboard_not_found":
            return f"storyboard {storyboard_id} not found in org {org} (deleted, or in another org)"
        return ("this Cardinal has no evidence upload route (it predates captured evidence): upgrade Cardinal, "
                "or report the result with storyboard__record_evidence")
    if status == 409:
        return ("storyboard " + storyboard_id + " is published, and a published storyboard is immutable: "
                "evidence can be added only to a draft")
    if status == 413:
        return "the upload is too large for this Cardinal: promote fewer entries at a time"
    if status == 429:
        return "Cardinal is rate-limiting evidence uploads for this org: wait a minute and promote again"
    if status in (501, 503):
        return "this Cardinal cannot store evidence uploads (" + (msg or code or f"HTTP {status}") + ")"
    if status == 502:
        return "Cardinal could not store the evidence: promote again"
    return f"maestro answered HTTP {status}" + (f" ({code})" if code else "") + (f": {msg}" if msg else "")


def post_upload(conn: dict, org: str, storyboard_id: str, body: bytes, auth: tuple,
                opener=None, sleep=time.sleep) -> dict:
    """POST one upload; the parsed 200 body. Retries 429 (Retry-After, at
    most MAX_429_RETRIES times); never follows a redirect."""
    rp = render_preview()
    kind, headers = auth
    path = f"/api/orgs/{urllib.parse.quote(org, safe='')}/storyboards/{storyboard_id}/evidence"
    url = conn["origin"] + path
    opener = opener or rp._opener()
    attempt = 0
    while True:
        req = urllib.request.Request(url, data=body, method="POST", headers={
            **headers,
            "Content-Type": "application/json",
            "Accept": "application/json",
        })
        try:
            with opener.open(req, timeout=REQUEST_TIMEOUT_S) as resp:
                raw = resp.read(8 << 20)
            try:
                out = json.loads(raw or b"{}")
            except ValueError:
                raise PromoteError("maestro answered with something other than JSON: upgrade Cardinal")
            if not isinstance(out, dict) or not isinstance(out.get("results"), list):
                raise PromoteError("maestro's answer has no per-item results: upgrade Cardinal")
            return out
        except urllib.error.HTTPError as err:
            err_body = rp._error_body(err)
            err.close()
            if err.code == 429 and attempt < MAX_429_RETRIES:
                attempt += 1
                try:
                    wait = int(err.headers.get("Retry-After") or 5)
                except (TypeError, ValueError):
                    wait = 5
                sleep(max(1, min(wait, 30)))
                continue
            if 300 <= err.code < 400:
                raise PromoteError(f"maestro redirected the upload (HTTP {err.code}); not following it with your "
                                   "credentials", status=err.code)
            raise PromoteError(explain_status(err.code, err_body, org, storyboard_id, kind), status=err.code,
                               code=str(err_body.get("error") or "") or None)
        except (urllib.error.URLError, OSError) as err:
            raise PromoteError(f"could not reach {conn['origin']}: {clip(getattr(err, 'reason', err))}")
        except http.client.HTTPException as err:
            raise PromoteError(f"could not read maestro's answer from {conn['origin']}: {type(err).__name__}")


def pick_storyboard(ev, root: Path, entries: dict) -> tuple:
    """(storyboard_id, None) for the one storyboard with a stored token in
    the entries' sessions, else (None, why)."""
    sessions = sorted({e.get("session_id") or ev.NO_SESSION for e in entries.values()})
    found = sorted({sb for s in sessions for (_, sb, _) in ev.find_tokens(root, session_id=s)})
    if len(found) == 1:
        return found[0], None
    if not found:
        return None, ("no storyboard to promote into: pass --storyboard sb_… (the id storyboard__create "
                      "returned)")
    return None, "more than one storyboard in this session: pass --storyboard (one of " + ", ".join(found) + ")"


def cmd_promote(args, out=sys.stdout, err=sys.stderr, opener=None, sleep=time.sleep, now=None) -> int:
    ev = evidence_mod()
    home = home_dir()
    root = ev.default_root(home)

    ids = []
    for raw in args.evidence_ids:
        if not ev.EVIDENCE_ID_RE.match(raw):
            err.write(f"cardinal-evidence: not an evidence id: {clip(raw, 80)!r} (expected ev_ + 12 hex)\n")
            return EXIT_FAILED
        if raw not in ids:
            ids.append(raw)
    sb = args.storyboard
    if sb is not None and not ev.STORYBOARD_ID_RE.match(sb):
        err.write(f"cardinal-evidence: not a storyboard id: {clip(sb, 80)!r} (expected sb_ + 24 hex)\n")
        return EXIT_FAILED

    results: dict = {}
    entries: dict = {}
    for ev_id in ids:
        entry = ev.read_entry(root, ev_id)
        if entry is None or entry.get("evidence_id") != ev_id:
            results[ev_id] = ("error", "not_in_spool", "no such entry on this machine (captured elsewhere, "
                              "removed after 14 days, or capture was off)")
        else:
            entries[ev_id] = entry

    if sb is None:
        if not entries:
            return report(ids, results, out, err)
        sb, why = pick_storyboard(ev, root, entries)
        if sb is None:
            err.write("cardinal-evidence: " + why + "\n")
            return EXIT_FAILED

    conn = connection(home, os.environ)
    if not conn:
        err.write("cardinal-evidence: Claude Code is not connected to Cardinal (no CARDINAL_MCP_URL): "
                  "run /cardinal:connect\n")
        return EXIT_FAILED

    token = None
    for _, _, rec in ev.find_tokens(root, sb):
        if ev.token_live(rec, now):
            token = rec
            break
    org = token["org"] if token else conn.get("org")
    if token and conn.get("org") and conn["org"] != token["org"]:
        err.write(f"cardinal-evidence: storyboard {sb} was created in org {token['org']}, but Claude Code is "
                  f"connected to org {conn['org']}: reconnect to that org (/cardinal:connect --rotate)\n")
        return EXIT_FAILED
    if not org:
        err.write(f"cardinal-evidence: no org for storyboard {sb}: CARDINAL_MCP_URL names none and no evidence "
                  "token was stored for it (call storyboard__preview to get a fresh one)\n")
        return EXIT_FAILED
    auths = []
    if token:
        auths.append(("token", {"Authorization": "CardinalEvidence " + token["evidence_token"]}))
    if conn.get("key"):
        auths.append(("key", {"X-CardinalHQ-API-Key": conn["key"]}))
    if not auths:
        err.write(f"cardinal-evidence: no credential for storyboard {sb}: no live evidence token was stored "
                  "for it (call storyboard__preview for a fresh one) and there is no Cardinal MCP key "
                  "(run /cardinal:connect)\n")
        return EXIT_FAILED

    client = plugin_client()
    rows = []
    for ev_id in ids:
        if ev_id not in entries:
            continue
        try:
            item = wire_item(entries[ev_id], client)
            encoded = json.dumps(item, ensure_ascii=False, separators=(",", ":"), allow_nan=False).encode("utf-8")
        except (ValueError, TypeError) as e:
            results[ev_id] = ("error", "invalid_entry", str(e))
            continue
        if len(encoded) + 16 > MAX_REQUEST_BYTES:
            results[ev_id] = ("error", "entry_too_large", "the entry is larger than one upload")
            continue
        rows.append((ev_id, item, encoded))

    planned = batches(rows)
    for bi, batch in enumerate(planned):
        body = b'{"items":[' + b",".join(r[2] for r in batch) + b"]}"
        answer = None
        failure = None
        while auths:
            try:
                answer = post_upload(conn, org, sb, body, auths[0], opener=opener, sleep=sleep)
                break
            except PromoteError as e:
                failure = e
                # A rejected token falls back to the key, for this and every later batch.
                if auths[0][0] == "token" and e.status in (401, 403) and len(auths) > 1:
                    auths.pop(0)
                    continue
                break
        if answer is None:
            # A whole-request refusal (auth, org, a published storyboard) would
            # refuse every later batch the same way: stop here.
            err.write(f"cardinal-evidence: upload to {sb} failed: {failure}\n")
            for rest in planned[bi:]:
                for ev_id, _, _ in rest:
                    results[ev_id] = ("error", "not_uploaded", str(failure))
            break
        by_index = {}
        for r in answer["results"]:
            if isinstance(r, dict) and isinstance(r.get("index"), int):
                by_index[r["index"]] = r
        for i, (ev_id, item, _) in enumerate(batch):
            r = by_index.get(i)
            if r is None:
                results[ev_id] = ("error", "no_result", "maestro returned no result for this entry")
            elif isinstance(r.get("receipt_id"), str) and RECEIPT_ID_RE.match(r["receipt_id"]):
                results[ev_id] = ("ok", r["receipt_id"], f"{item['source_server']}/{item['tool']}")
            else:
                e = r.get("error") if isinstance(r.get("error"), dict) else {}
                results[ev_id] = ("error", clip(e.get("code") or "rejected", 60), clip(e.get("message")))
    return report(ids, results, out, err, sb)


def report(ids: list, results: dict, out, err, sb: str | None = None) -> int:
    ok = 0
    for ev_id in ids:
        kind, a, b = results.get(ev_id, ("error", "not_uploaded", ""))
        if kind == "ok":
            ok += 1
            out.write(f"{ev_id} -> {a}  ({clip(b, 200)}, captured)\n")
        else:
            out.write(f"{ev_id}: error {a}: {b}\n")
    failed = len(ids) - ok
    if ok:
        out.write(f"{ok} promoted" + (f" to {sb}" if sb else "") + (f", {failed} failed" if failed else "") +
                  ". Bind each rcpt_ id like any receipt; the storyboard labels it captured.\n")
    if ok == 0:
        return EXIT_FAILED
    return EXIT_ITEM_ERRORS if failed else EXIT_OK


# ---------------------------------------------------------------------------
# list / off / on / status
# ---------------------------------------------------------------------------

def current_session(ev, root: Path, environ: dict):
    for value in (environ.get("CLAUDE_CODE_SESSION_ID"), environ.get("CLAUDE_SESSION_ID")):
        if isinstance(value, str) and ev.SESSION_ID_RE.match(value) and (root / value).is_dir():
            return value
    dirs = ev.session_dirs(root)
    return dirs[0][0] if dirs else None


def _size(entry: dict) -> str:
    try:
        n = len(json.dumps(entry.get("result"), ensure_ascii=False).encode("utf-8"))
    except (TypeError, ValueError):
        return "?"
    return f"{n} B" if n < 1024 else f"{n / 1024:.1f} KiB"


def cmd_list(args, out=sys.stdout, err=sys.stderr) -> int:
    ev = evidence_mod()
    root = ev.default_root(home_dir())
    if args.all:
        sessions = [name for name, _ in ev.session_dirs(root)]
    elif args.session:
        if not ev.SESSION_ID_RE.match(args.session):
            err.write("cardinal-evidence: not a session id\n")
            return EXIT_FAILED
        sessions = [args.session]
    else:
        s = current_session(ev, root, os.environ)
        sessions = [s] if s else []
    if not sessions:
        out.write(f"No captured evidence in {root}.\n")
        return EXIT_OK
    for s in sessions:
        entries = ev.list_entries(root, s)
        shown = entries[-args.limit:] if args.limit > 0 else entries
        out.write(f"session {s}: {len(entries)} captured"
                  + (f" (newest {len(shown)} shown)" if len(shown) < len(entries) else "") + "\n")
        for e in shown:
            line = (f"  {e['evidence_id']}  {clip(e.get('called_at'), 40)}  "
                    f"{clip(e.get('server'), 80)}/{clip(e.get('tool'), 120)}  {_size(e)}")
            if e.get("truncated"):
                line += "  truncated"
            out.write(line + "\n")
        for sb, rec in sorted(ev.read_tokens(root, s).items()):
            state = "live" if ev.token_live(rec) else "expired"
            out.write(f"  evidence token for {sb} (org {rec['org']}, {state}"
                      + (f", expires {rec['expires_at']}" if rec.get("expires_at") else "") + ")\n")
    return EXIT_OK


def disabled_reason(ev, root: Path, home: Path, environ: dict):
    for label, env in (("the environment", environ), ("~/.claude/settings.json", settings_env(home))):
        v = str(env.get("CARDINAL_EVIDENCE_CAPTURE", "")).strip().lower()
        if v in ("0", "false", "off", "no"):
            return f"CARDINAL_EVIDENCE_CAPTURE={v} in {label}"
    if ev.capture_disabled(root, {}):
        return f"the flag file {root / ev.DISABLED_FLAG}"
    return None


def cmd_off(args, out=sys.stdout, err=sys.stderr) -> int:
    ev = evidence_mod()
    root = ev.default_root(home_dir())
    ev.set_capture_disabled(root, True)
    out.write("Evidence capture is off: results from other MCP servers are no longer kept. Entries already "
              f"captured stay in {root} until they age out (14 days). `cardinal-evidence on` resumes.\n")
    return EXIT_OK


def cmd_on(args, out=sys.stdout, err=sys.stderr) -> int:
    ev = evidence_mod()
    home = home_dir()
    root = ev.default_root(home)
    ev.set_capture_disabled(root, False)
    why = disabled_reason(ev, root, home, os.environ)
    if why:
        out.write(f"Removed the flag file, but capture is still off: {why}. Remove that setting to resume.\n")
        return EXIT_OK
    out.write("Evidence capture is on: results from non-Cardinal MCP servers are kept locally until you "
              "promote them.\n")
    return EXIT_OK


def cmd_status(args, out=sys.stdout, err=sys.stderr) -> int:
    ev = evidence_mod()
    home = home_dir()
    root = ev.default_root(home)
    why = disabled_reason(ev, root, home, os.environ)
    out.write(f"capture: {'off (' + why + ')' if why else 'on'}\n")
    dirs = ev.session_dirs(root)
    n = sum(len(ev.list_entries(root, name)) for name, _ in dirs)
    out.write(f"spool: {root} ({n} entries in {len(dirs)} sessions; entries are removed after 14 days)\n")
    tokens = [(s, sb, rec) for s, sb, rec in ev.find_tokens(root) if ev.token_live(rec)]
    out.write(f"evidence tokens: {len(tokens)} live" + (" (" + ", ".join(sorted({sb for _, sb, _ in tokens})) + ")"
                                                         if tokens else "") + "\n")
    conn = connection(home, os.environ)
    if conn:
        out.write(f"uploads go to: {conn['origin']}" + (f" (org {conn['org']})" if conn.get("org") else "")
                  + (", Cardinal MCP key present" if conn.get("key") else ", no Cardinal MCP key") + "\n")
    else:
        out.write("uploads go to: nowhere yet (not connected: run /cardinal:connect)\n")
    return EXIT_OK


# ---------------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="cardinal-evidence",
        description="Cite results from other MCP servers in a Cardinal storyboard: promote locally captured "
                    "evidence to captured receipts.",
    )
    sub = p.add_subparsers(dest="command", metavar="{promote,list,off,on,status}")
    pr = sub.add_parser("promote", help="upload spool entries to a draft storyboard as captured receipts")
    pr.add_argument("--storyboard", metavar="SB_ID",
                    help="the draft storyboard (sb_…); default: the one storyboard created in this session")
    pr.add_argument("evidence_ids", nargs="+", metavar="ev_ID")
    ls = sub.add_parser("list", help="this session's captured evidence")
    grp = ls.add_mutually_exclusive_group()
    grp.add_argument("--session", metavar="ID", help="a Claude Code session id (default: this or the newest)")
    grp.add_argument("--all", action="store_true", help="every session in the spool")
    ls.add_argument("--limit", type=int, default=50, help="newest N entries per session (0: all; default 50)")
    sub.add_parser("off", help="stop capturing MCP results")
    sub.add_parser("on", help="resume capturing MCP results")
    sub.add_parser("status", help="capture state, spool size and upload target")
    return p


def main(argv: list | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    handlers = {"promote": cmd_promote, "list": cmd_list, "off": cmd_off, "on": cmd_on, "status": cmd_status}
    if args.command not in handlers:
        parser.print_help(sys.stderr)
        return EXIT_FAILED
    try:
        return handlers[args.command](args)
    except OSError as e:
        sys.stderr.write(f"cardinal-evidence: {type(e).__name__}: {clip(e)}\n")
        return EXIT_FAILED


if __name__ == "__main__":
    sys.exit(main())
