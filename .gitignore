__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.venv/
venv/
dist/
.DS_Store
# vendored copies are build outputs, not source
adapters/*/hooks/cardinal_core/
# Stage 8/9 outputs are regenerated on every /mechanize compile — never commit.
mechanize-out/*/preview.html
mechanize-out/*/rubric.md
mechanize-out/*/review.md
# k8s controller test caches — pyc + pytest cache aren't source.
k8s/controller/__pycache__/
k8s/controller/tests/__pycache__/
k8s/controller/.pytest_cache/
# Session-local working notes and tool state — never source. Plans and
# handoffs here reference absolute local paths and live prod runbooks;
# anything meant to be shared belongs in docs/ proper.
docs/local-notes/
.polly/
